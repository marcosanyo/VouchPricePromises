.visuals/

# Local store (Channel3 payloads, contracts). The live database is never
# committed; data/snapshot/vouch.db (npm -w server run snapshot) is, so other
# sessions can restore it. Keep data/ out of the public (orphan) repository.
data/*.db
data/*.db-*
data/ml/
ml/.venv/

# Claude Code worktrees and local settings
.claude/
