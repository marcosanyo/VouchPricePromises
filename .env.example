# ==============================================================================
# Vouch — environment
# Copy to .env and fill in. Never commit .env or service-account keys.
# Every variable below is required unless marked optional; the app fails at
# startup if one is missing (docs/NO_FALLBACK_POLICY.md). Providers are chosen
# explicitly here and are never switched automatically on error.
# ==============================================================================

# --- App ---
PORT=3000

# --- Google Cloud / Vertex AI (the only LLM: Gemini 3.8 Flash) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
# Local only: absolute path to the service-account key. On Cloud Run, leave unset
# and use the attached service account.
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_MODEL_ID=gemini-3.8-flash

# --- Image generation (main: Nano Banana 2.1 on Vertex AI) ---
IMAGE_PROVIDER=vertex_gemini
IMAGE_MODEL_ID=gemini-nano-banana-2.1

# --- PayPal Sandbox (Merchant app on the US Business account) ---
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Additional Sandbox sellers (one Merchant app per Business account), B plan
PAYPAL_SELLER_2_CLIENT_ID=
PAYPAL_SELLER_2_CLIENT_SECRET=
PAYPAL_SELLER_3_CLIENT_ID=
PAYPAL_SELLER_3_CLIENT_SECRET=

# --- Channel3 (products, per-store prices, price tracking) ---
CHANNEL3_API_KEY=

# --- Optional ---
# PayPal webhook id (after registering the Cloud Run URL). The webhook route
# answers 503 naming this variable while it is unset.
PAYPAL_WEBHOOK_ID=
# Local SQLite path (default: data/vouch.db)
VOUCH_DB_PATH=

# --- Cloud Run demo password (user: judge); read only by scripts/deploy.sh ---
CLOUD_RUN_DEMO_PASSWORD=
